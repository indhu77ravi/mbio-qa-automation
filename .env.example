# Copy to .env (never commit .env)
# Region profile: ae (default, https://mb.io/en-AE) or global (https://mb.io/en)
TARGET=ae
# Browser: chromium (default) | chrome | firefox | webkit
BROWSER=chromium
# true = no window. Defaults to false locally, true when CI is set
# HEADLESS=false
# Milliseconds to pause between actions, to watch runs
# SLOWMO=0
# Screenshot after every step (true/false)
STEP_SCREENSHOTS=true
# Visual regression: baseline = capture, anything else = compare
# VISUAL_MODE=compare
# Regional proxy for runners outside the UAE (the site geo-redirects by IP)
# PROXY_SERVER=http://proxy.example:8080
# Point the profile at another host, e.g. staging
# BASE_URL=https://mb.io
