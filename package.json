{
  "name": "mbio-qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + Cucumber.js BDD framework with Allure reporting for mb.io (MultiBank Group)",
  "scripts": {
    "setup": "npm ci && npx playwright install --with-deps",
    "test": "cucumber-js",
    "test:smoke": "cucumber-js -p smoke",
    "test:regression": "cucumber-js -p regression",
    "test:parallel": "cucumber-js -p parallel",
    "test:mobile": "cucumber-js -p mobile",
    "test:known-bugs": "cucumber-js -p knownBugs",
    "test:chrome": "cross-env BROWSER=chrome cucumber-js",
    "test:firefox": "cross-env BROWSER=firefox cucumber-js",
    "test:webkit": "cross-env BROWSER=webkit cucumber-js",
    "test:cross-browser": "node scripts/cross-browser.js",
    "test:global": "cross-env TARGET=global cucumber-js",
    "test:headless": "cross-env HEADLESS=true cucumber-js",
    "test:report": "node scripts/run-and-report.js",
    "test:run-and-open": "node scripts/run-and-report.js --open",
    "visual:baseline": "cross-env VISUAL_MODE=baseline cucumber-js -p visual",
    "visual:compare": "cucumber-js -p visual",
    "visual:compare:report": "node scripts/run-and-report.js --open -p visual",
    "allure:clean": "rimraf allure-results allure-report reports",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "steps:dry-run": "cucumber-js --dry-run --format summary",
    "steps:usage": "cucumber-js --dry-run --format usage",
    "unit": "node --test \"tests/unit/**/*.test.js\"",
    "discover": "node scripts/discover.js",
    "trace": "playwright show-trace"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@playwright/test": "1.63.0",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.12.2",
    "allure-js-commons": "^3.12.2",
    "cross-env": "^10.1.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "rimraf": "^6.1.3"
  },
  "dependencies": {
    "dotenv": "^18.0.2"
  }
}
